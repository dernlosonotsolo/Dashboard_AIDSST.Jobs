  "mismatch_insights": [
    {
      "title": "Severe MLOps & Production Infrastructure Gap",
      "severity": "Critical",
      "description": "82% of job vacancies demand cloud computing (AWS/GCP/Azure) and CI/CD/MLOps deployment skills, yet fewer than 25% of university curricula include dedicated courses on deploying and maintaining production ML models.",
      "metric": "-56.5% Net Gap"
    },
    {
      "title": "SQL & Real-World Data Pipelines Under-Emphasized",
      "severity": "High",
      "description": "While academic courses heavily emphasize theoretical mathematics, 89% of industry job postings mandate production SQL, ETL workflows, and data cleaning, where academic coverage averages only 65%.",
      "metric": "-24.0% Net Gap"
    },
    {
      "title": "Generative AI & LLM Operationalization Shortage",
      "severity": "Critical",
      "description": "Industry demand for Generative AI, Retrieval-Augmented Generation (RAG), and fine-tuning has surged to 72% in recent postings, while only 25% of existing degree programs have incorporated GenAI modules.",
      "metric": "-47.0% Net Gap"
    },
    {
